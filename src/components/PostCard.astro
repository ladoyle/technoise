---
// An editorial entry, not a box: a hairline above it and nothing else. The separator
// belongs to the card so any container can hold a run of them.

import TagPill from "./TagPill.astro";
import { formatDate, isoDate } from "../lib/content";

interface Props {
  title: string;
  href: string;
  description: string;
  pubDate: Date;
  minutes: number;
  tags: string[];
  headingLevel?: 2 | 3;
}

const { title, href, description, pubDate, minutes, tags, headingLevel = 2 } = Astro.props;

const Heading = `h${headingLevel}` as "h2" | "h3";
---

<article class="post-card">
  <p class="post-card__meta">
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </p>

  <Heading class="post-card__title"><a href={href}>{title}</a></Heading>

  <p class="post-card__excerpt">{description}</p>

  {
    tags.length > 0 && (
      <ul class="post-card__tags">
        {tags.map((tag) => (
          <li>
            <TagPill label={tag} href={`/blog/tags/${tag}/`} />
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card {
    border-block-start: var(--hairline) solid var(--border);
    padding-block: var(--space-32);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-meta);
    line-height: var(--lh-tight);
  }

  .post-card__title {
    margin: var(--space-8) 0 0;
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  /* No underline at rest because the heading is not a link inside a sentence; the
     underline arrives with the colour change, so colour never carries it alone. */
  .post-card__title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-card__title a:hover,
  .post-card__title a:focus-visible {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .post-card__excerpt {
    margin: var(--space-12) 0 0;
    color: var(--text);
    font-size: var(--size-18);
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: var(--space-16) 0 0;
    padding: 0;
    list-style: none;
  }
</style>
