---
// The brand is the committed logo SVG rather than live text. What makes an image
// acceptable on a header that renders on every page is that the file is vector and
// carries its own fills as three classes with a prefers-color-scheme: dark override
// — so it stays sharp at any DPR and recolours with the page instead of baking
// light-mode ink into the pixels, which is what ruled out the raster exports.
// The <picture> hinges on the same 48em breakpoint as the nav collapse below, so
// the header still has exactly one responsive breakpoint to reason about.
//
// Known gap: the file is referenced by URL, not inlined, so its dark mode follows
// the OS prefers-color-scheme only — a future ThemeToggle setting the scheme
// manually will not reach inside it.
//
// Every route below returns 200. /about/ is not in the list because the page does not
// exist yet — a nav item that promises a 404 is worse than no nav item, so About
// returns to both this list and the footer's when the page does.
//
// The disclosure below is the site's one JS island, and it is deliberate. A toggle
// with aria-expanded, aria-controls, Escape-to-close and click-outside cannot be built
// from HTML and CSS: <details>/<summary> was the zero-JS candidate and loses on all
// three. The cost is bounded — below 48em only, and with JS off the toggle never
// appears and the whole list renders stacked, which is exactly the old behaviour.

const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/resume/", label: "Resume" },
  { href: "/styleguide/", label: "Styleguide" },
];

const here = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? here === "/" : here.startsWith(href);
---

<header class="site-header" data-nav-root data-nav="closed">
  <div class="wrap wrap--wide site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-current={here === "/" ? "page" : undefined}
    >
      <picture>
        <source
          media="(min-width: 48em)"
          srcset="/brand/technoise-logo-full.svg"
          width="1319"
          height="514"
        />
        <img
          src="/brand/technoise-logo-presentation.svg"
          alt="TechNoise — Hear the future"
          width="918"
          height="835"
        />
      </picture>
    </a>

    <button
      class="site-header__toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <svg
        data-icon="open"
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        data-icon="close"
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
      Menu
    </button>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__list" id="primary-nav">
        {
          nav.map((item) => (
            <li>
              <a
                class="site-header__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav-root]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");

  if (header && toggle) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    // The label and the icons are never rewritten here: CSS swaps them off
    // aria-expanded, so the accessible name and the visual state cannot disagree.
    const setOpen = (open: boolean) => {
      header.dataset.nav = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    border-block-end: var(--hairline) solid var(--border);
  }

  /*
    Below the breakpoint the brand and the toggle share the first row and the nav
    wraps onto a second. Above it the row-100% basis is dropped and the two sit on
    one line, which is what the header has always looked like at that width.
  */
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8) var(--space-32);
    padding-block: var(--space-16);
  }

  .site-header__brand {
    display: flex;
    flex: 0 0 auto;
  }

  /*
    block-size is the only constraint; inline-size follows whichever source <picture>
    picked, so each file keeps its own ratio. The stacked file's ratio is on the <img>
    attributes so the box is reserved before the SVG arrives.

    48px here because it is free: the toggle's 44px-target floor already sets the
    mobile row's height, so the stacked mark costs no extra rows. The wide breakpoint
    steps down to 32px — see the override below.
  */
  .site-header__brand img {
    inline-size: auto;
    block-size: var(--space-48);
  }

  .site-header__nav {
    flex: 1 0 100%;
  }

  /*
    min-block-size, not more padding: the specified 8px/12px padding around a 24px
    icon lands at ~42px, and WCAG 2.5.5's 44px target is the floor this has to clear.
  */
  .site-header__toggle {
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-48);
    padding: var(--space-8) var(--space-12);
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: var(--size-16);
    line-height: var(--lh-tight);
    cursor: pointer;
  }

  .site-header__toggle:hover {
    color: var(--link);
  }

  .site-header__toggle [data-icon] {
    display: none;
    inline-size: var(--space-24);
    block-size: var(--space-24);
  }

  .site-header__toggle[aria-expanded="false"] [data-icon="open"],
  .site-header__toggle[aria-expanded="true"] [data-icon="close"] {
    display: block;
  }

  .site-header__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    border-block-start: var(--hairline) solid var(--border);
    list-style: none;
  }

  .site-header__link {
    display: inline-block;
    padding-block: var(--space-12);
    color: var(--text);
    font-size: var(--size-16);
    line-height: var(--lh-tight);
    text-decoration: none;
  }

  .site-header__link:hover {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .site-header__link[aria-current="page"] {
    color: var(--link);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /*
    The collapse. The base rule hides the panel and the min-width block re-declares
    the same selector at equal specificity, so source order restores it — one
    breakpoint, no max-width query, no !important. With no `js` class on <html> the
    toggle stays hidden and the list stays visible: the no-JS fallback is the default,
    not an afterthought.
  */
  .site-header__toggle {
    display: none;
  }

  :global(html.js) .site-header__toggle {
    display: inline-flex;
  }

  :global(html.js) .site-header[data-nav="closed"] .site-header__list {
    display: none;
  }

  @media (min-width: 48em) {
    .site-header__inner {
      flex-wrap: nowrap;
      align-items: center;
      padding-block: var(--space-24);
    }

    /*
      A step down, not up. The horizontal file sets the wordmark beside the mascot
      rather than under it, so its lettering is taller than the stacked file's at the
      same box height — 32px here reads at least as large as 48px does below the
      breakpoint. At 32px the mark is also shorter than the nav links' own 35px line
      box, so the nav sets this row's height and it measures the same 83px it did when
      the brand was text.
    */
    .site-header__brand img {
      block-size: var(--space-32);
    }

    .site-header__nav {
      flex: 0 0 auto;
    }

    .site-header__list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4) var(--space-16);
      border-block-start: 0;
    }

    .site-header__link {
      padding-block: var(--space-8);
    }

    :global(html.js) .site-header__toggle {
      display: none;
    }

    :global(html.js) .site-header[data-nav="closed"] .site-header__list {
      display: flex;
    }
  }
</style>
