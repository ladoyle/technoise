---
import presentationSvg from "../../public/brand/technoise-logo-presentation.svg?raw";
import fullSvg from "../../public/brand/technoise-logo-full.svg?raw";

// The brand is the committed logo SVG rather than live text, and it is inlined here
// rather than referenced by URL. Referenced, the mark's dark mode could only come from
// the prefers-color-scheme override inside the file itself — which the embedding page's
// CSS cannot reach, and which a forced-dark filter or a non-Chromium engine may never
// evaluate at all. When it does not fire, .tn-ink stays #0c3242 on a --surface that is
// also #0c3242: 1.00:1, an invisible mark, which is what was reported. Inlined, the
// fills resolve through the same tokens.css cascade as every other element on the page
// (see the <style> block below), so the mark is as reliable as the nav text beside it.
//
// The files under public/brand/ stay the single source of truth: both marks are read
// here at build time, viewBox and all, so a re-export cannot desync a hand-copied path
// or dimension. Footer.astro still references the same two files by URL.
//
// The two marks swap on the same 48em breakpoint as the nav collapse below, by the same
// display technique as the toggle's own icons, so the header still has exactly one
// responsive breakpoint to reason about.
//
// Every route below returns 200. /about/ is not in the list because the page does not
// exist yet — a nav item that promises a 404 is worse than no nav item, so About
// returns to both this list and the footer's when the page does.
//
// The disclosure below is the site's one JS island, and it is deliberate. A toggle
// with aria-expanded, aria-controls, Escape-to-close and click-outside cannot be built
// from HTML and CSS: <details>/<summary> was the zero-JS candidate and loses on all
// three. The cost is bounded — below 48em only, and with JS off the toggle never
// appears and the whole list renders stacked, which is exactly the old behaviour.

type Mark = { viewBox: string; width: string; height: string; body: string };

const brandMark = (file: string, source: string): Mark => {
  const viewBox = /viewBox="([^"]+)"/.exec(source)?.[1];
  const styleEnd = source.indexOf("</style>");
  const svgEnd = source.lastIndexOf("</svg>");
  const box = viewBox?.trim().split(/\s+/) ?? [];

  // A build-time throw rather than a silent fallback: a brand SVG that stops matching
  // this shape must stop the build, not render a mark with no geometry.
  if (!viewBox || box.length !== 4 || styleEnd < 0 || svgEnd < 0) {
    throw new Error(`public/brand/${file} is not the expected single-<style> brand SVG`);
  }

  return {
    viewBox,
    width: box[2],
    height: box[3],
    body: source.slice(styleEnd + "</style>".length, svgEnd),
  };
};

const marks = {
  stacked: brandMark("technoise-logo-presentation.svg", presentationSvg),
  wide: brandMark("technoise-logo-full.svg", fullSvg),
};

const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/resume/", label: "Resume" },
  { href: "/styleguide/", label: "Styleguide" },
];

const here = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? here === "/" : here.startsWith(href);
---

<header class="site-header" data-nav-root data-nav="closed">
  <div class="wrap wrap--wide site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-label="TechNoise — Hear the future"
      aria-current={here === "/" ? "page" : undefined}
    >
      {
        (["stacked", "wide"] as const).map((variant) => (
          <svg
            data-mark={variant}
            aria-hidden="true"
            focusable="false"
            viewBox={marks[variant].viewBox}
            width={marks[variant].width}
            height={marks[variant].height}
          >
            <Fragment set:html={marks[variant].body} />
          </svg>
        ))
      }
    </a>

    <button
      class="site-header__toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <svg
        data-icon="open"
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        data-icon="close"
        aria-hidden="true"
        focusable="false"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
      Menu
    </button>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__list" id="primary-nav">
        {
          nav.map((item) => (
            <li>
              <a
                class="site-header__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav-root]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");

  if (header && toggle) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    // The label and the icons are never rewritten here: CSS swaps them off
    // aria-expanded, so the accessible name and the visual state cannot disagree.
    const setOpen = (open: boolean) => {
      header.dataset.nav = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    border-block-end: var(--hairline) solid var(--border);
  }

  /*
    Below the breakpoint the brand and the toggle share the first row and the nav
    wraps onto a second. Above it the row-100% basis is dropped and the two sit on
    one line, which is what the header has always looked like at that width.
  */
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8) var(--space-32);
    padding-block: var(--space-16);
  }

  .site-header__brand {
    display: flex;
    flex: 0 0 auto;
  }

  /*
    block-size is the only constraint; inline-size follows each mark's own viewBox ratio,
    which its width/height attributes carry, so the box is reserved before any CSS loads.

    48px here because it is free: the toggle's 44px-target floor already sets the
    mobile row's height, so the stacked mark costs no extra rows. The wide mark holds the
    same 48px across the hinge — the horizontal lockup spends 72.6% of its viewBox height
    on ink against the stacked file's 88.3%, so matching the box is what keeps the mark
    from shrinking at the breakpoint.
  */
  .site-header__brand [data-mark] {
    inline-size: auto;
    block-size: var(--space-48);
  }

  /*
    The same swap the toggle's icons use below, one breakpoint, no max-width query. Both
    marks are in the DOM either way; only one is ever painted.
  */
  .site-header__brand [data-mark="wide"] {
    display: none;
  }

  /*
    The mark's fills. These are the SVG files' own three classes, but the files' internal
    prefers-color-scheme block is stripped on the way in (see the frontmatter), so the
    values resolve here instead — same tokens, same pairs, live in the page's cascade.
    :global because the injected <path> elements carry no scope attribute; the selector
    still starts at this component's own .site-header__brand.

    The dark override is written twice for the same reason tokens.css writes its own dark
    block twice: the media query is what ships, and the [data-theme="dark"] twin keeps a
    later ThemeToggle from flipping the page to ink while leaving this mark ink-coloured.
    Both stay scoped to `screen`, so the printed page keeps the light fills.
  */
  .site-header__brand :global(.tn-ink) {
    fill: var(--ink);
  }

  .site-header__brand :global(.tn-signal) {
    fill: var(--signal);
  }

  .site-header__brand :global(.tn-pulse) {
    fill: var(--pulse);
  }

  @media screen and (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .site-header__brand :global(.tn-ink) {
      fill: var(--cream-dim);
    }

    :global(:root:not([data-theme="light"])) .site-header__brand :global(.tn-signal) {
      fill: var(--signal-300);
    }

    :global(:root:not([data-theme="light"])) .site-header__brand :global(.tn-pulse) {
      fill: var(--pulse-300);
    }
  }

  @media screen {
    :global(:root[data-theme="dark"]) .site-header__brand :global(.tn-ink) {
      fill: var(--cream-dim);
    }

    :global(:root[data-theme="dark"]) .site-header__brand :global(.tn-signal) {
      fill: var(--signal-300);
    }

    :global(:root[data-theme="dark"]) .site-header__brand :global(.tn-pulse) {
      fill: var(--pulse-300);
    }
  }

  .site-header__nav {
    flex: 1 0 100%;
  }

  /*
    min-block-size, not more padding: the specified 8px/12px padding around a 24px
    icon lands at ~42px, and WCAG 2.5.5's 44px target is the floor this has to clear.
  */
  .site-header__toggle {
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-48);
    padding: var(--space-8) var(--space-12);
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: var(--size-16);
    line-height: var(--lh-tight);
    cursor: pointer;
  }

  .site-header__toggle:hover {
    color: var(--link);
  }

  .site-header__toggle [data-icon] {
    display: none;
    inline-size: var(--space-24);
    block-size: var(--space-24);
  }

  .site-header__toggle[aria-expanded="false"] [data-icon="open"],
  .site-header__toggle[aria-expanded="true"] [data-icon="close"] {
    display: block;
  }

  .site-header__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    border-block-start: var(--hairline) solid var(--border);
    list-style: none;
  }

  .site-header__link {
    display: inline-block;
    padding-block: var(--space-12);
    color: var(--text);
    font-size: var(--size-16);
    line-height: var(--lh-tight);
    text-decoration: none;
  }

  .site-header__link:hover {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .site-header__link[aria-current="page"] {
    color: var(--link);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /*
    The collapse. The base rule hides the panel and the min-width block re-declares
    the same selector at equal specificity, so source order restores it — one
    breakpoint, no max-width query, no !important. With no `js` class on <html> the
    toggle stays hidden and the list stays visible: the no-JS fallback is the default,
    not an afterthought.
  */
  .site-header__toggle {
    display: none;
  }

  :global(html.js) .site-header__toggle {
    display: inline-flex;
  }

  :global(html.js) .site-header[data-nav="closed"] .site-header__list {
    display: none;
  }

  @media (min-width: 48em) {
    .site-header__inner {
      flex-wrap: nowrap;
      align-items: center;
      padding-block: var(--space-24);
    }

    /*
      The lockup swaps here and the 48px box does not, which is what makes the brand —
      not the nav's 35px line box — the thing that sets this row's 96px height.
    */
    .site-header__brand [data-mark="stacked"] {
      display: none;
    }

    .site-header__brand [data-mark="wide"] {
      display: block;
    }

    .site-header__nav {
      flex: 0 0 auto;
    }

    /*
      nowrap, not wrap: the run was already horizontal here, but nothing stopped a
      fifth item, a longer label or 150% zoom from dropping links onto a second line at
      a 4px row gap — which is indistinguishable from a broken nav. 24px of column gap
      also keeps the four links from reading as a huddle beside the larger mark above.
    */
    .site-header__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: var(--space-24);
      border-block-start: 0;
    }

    .site-header__link {
      padding-block: var(--space-8);
    }

    :global(html.js) .site-header__toggle {
      display: none;
    }

    :global(html.js) .site-header[data-nav="closed"] .site-header__list {
      display: flex;
    }
  }
</style>
