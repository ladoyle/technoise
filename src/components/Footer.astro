---
import presentationSvg from "../../public/brand/technoise-logo-presentation.svg?raw";
import fullSvg from "../../public/brand/technoise-logo-full.svg?raw";

import { brandMark } from "../lib/brand-mark";
import { profiles } from "../lib/resume";

// Four blocks on the wide column: brand, navigation, elsewhere, colophon. All stacked
// below the breakpoint; above it brand and navigation share a row and elsewhere and the
// colophon share the next, because a horizontal five-link run and the colophon cannot
// both fit a row at 48em.
//
// The brand repeats the header's logo pair on the same 48em hinge, at the same 48px, and
// by the same mechanism: both marks are inlined at build time so their fills resolve in
// this page's cascade rather than inside a referenced image document. Referenced, dark
// mode could only come from the prefers-color-scheme block inside the file, which a
// forced-dark filter or a non-Chromium engine may never evaluate — and when it does not
// fire, .tn-wordmark stays ink on a --surface that is also ink: 1.00:1, an invisible
// wordmark. The mascot's own 1.000:1 in dark mode is a separate, deliberate freeze; see
// Header.astro, whose fill rules below are reproduced exactly.
//
// Elsewhere carries GitHub and LinkedIn and nothing else because `profiles` is the one
// place a profile URL is derived: SITE.author.sameAs feeds the resume's contact list, its
// JSON-LD sameAs and this block together, so a third profile is added there and never
// typed here. The email address is deliberately not among them — it stays on /resume/,
// which a reader reaches on purpose, rather than sitting on every page of the site.
//
// About is absent for a different reason: /about/ does not exist yet and the link
// would 404. It returns here, and to the header, when the page does.

const marks = {
  stacked: brandMark("technoise-logo-presentation.svg", presentationSvg),
  wide: brandMark("technoise-logo-full.svg", fullSvg),
};

const year = new Date().getFullYear();

const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/resume/", label: "Resume" },
  { href: "/styleguide/", label: "Styleguide" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="site-footer">
  <div class="wrap wrap--wide site-footer__inner">
    <div class="site-footer__brand">
      {
        (["stacked", "wide"] as const).map((variant) => (
          <svg
            data-mark={variant}
            aria-hidden="true"
            focusable="false"
            viewBox={marks[variant].viewBox}
            width={marks[variant].width}
            height={marks[variant].height}
          >
            <Fragment set:html={marks[variant].body} />
          </svg>
        ))
      }
    </div>

    <nav aria-label="Footer">
      <ul class="site-footer__list">
        {
          nav.map((item) => (
            <li>
              <a class="site-footer__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      profiles.length > 0 && (
        <div class="site-footer__elsewhere">
          <h2 id="footer-elsewhere" class="eyebrow site-footer__heading">
            Elsewhere
          </h2>
          <ul class="site-footer__list" aria-labelledby="footer-elsewhere">
            {profiles.map((profile) => (
              <li>
                <a class="site-footer__link" href={profile.href}>
                  {profile.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="site-footer__colophon">
      <p>&copy; {year} TechNoise</p>
      <p>Built with Astro. Hosted on GitHub Pages.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-96);
    border-block-start: var(--hairline) solid var(--border);
    color: var(--text-muted);
    font-size: var(--size-16);
  }

  /*
    The base rules here are the small-screen design, and the media block below reverts
    what the desktop layout should not inherit. At 320px this block is the densest on
    the site — five stacked link rows under a mark and over a colophon — so it gets the
    looser of the two sets of values, not the tighter one.
  */
  .site-footer__inner {
    display: grid;
    gap: var(--space-48);
    padding-block: var(--space-64);
  }

  /* flex so the inlined marks blockify: inside a grid item they would otherwise sit on a
     text baseline and add a descender's worth of height under a 48px box. */
  .site-footer__brand {
    display: flex;
  }

  /* The same 48px box as the header's mark, either side of the hinge. It used to sit one
     spacing step under, which read as small rather than as secondary — and the scale has
     no step between 32 and 48, so matching the header is the only on-scale way up. The
     mark's apparent size still changes across the hinge, because the lockup swaps from the
     stacked one to the horizontal one. block-size is the only constraint; inline-size
     follows each mark's own viewBox ratio, carried by its width/height attributes. */
  .site-footer__brand [data-mark] {
    inline-size: auto;
    block-size: var(--space-48);
  }

  /* The swap the <source media> used to make, now one CSS breakpoint and no max-width
     query — the same technique and the same hinge the header's pair uses. Both marks are
     in the DOM either way; only one is ever painted. */
  .site-footer__brand [data-mark="wide"] {
    display: none;
  }

  /*
    The mark's fills, reproducing Header.astro's five pairs exactly. These are the SVG
    files' own classes, but each file's internal prefers-color-scheme block is stripped on
    the way in, so the values resolve here instead — same tokens, live in the page's
    cascade. :global because the injected <path> elements carry no scope attribute; the
    selector still starts at this component's own .site-footer__brand.

    Only the text adapts. .tn-ink, .tn-signal and .tn-pulse are the mascot and are frozen
    at their light fills in both schemes, on purpose, and the freeze is implemented by
    absence: they have no dark rule at all. Adding one back "for symmetry" would undo the
    cycle that froze them. The dark override is written twice for the reason tokens.css
    writes its own dark block twice — the media query is what ships, the [data-theme="dark"]
    twin keeps a later ThemeToggle from flipping the page to ink while leaving the wordmark
    ink-coloured. Both stay scoped to `screen`, so the printed page keeps the light fills.
  */
  .site-footer__brand :global(.tn-ink) {
    fill: var(--ink);
  }

  .site-footer__brand :global(.tn-signal) {
    fill: var(--signal);
  }

  .site-footer__brand :global(.tn-pulse) {
    fill: var(--pulse);
  }

  .site-footer__brand :global(.tn-wordmark) {
    fill: var(--ink);
  }

  .site-footer__brand :global(.tn-tagline) {
    fill: var(--signal);
  }

  @media screen and (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .site-footer__brand :global(.tn-wordmark) {
      fill: var(--cream-dim);
    }

    :global(:root:not([data-theme="light"])) .site-footer__brand :global(.tn-tagline) {
      fill: var(--signal-300-dim);
    }
  }

  @media screen {
    :global(:root[data-theme="dark"]) .site-footer__brand :global(.tn-wordmark) {
      fill: var(--cream-dim);
    }

    :global(:root[data-theme="dark"]) .site-footer__brand :global(.tn-tagline) {
      fill: var(--signal-300-dim);
    }
  }

  /* One column below the hinge for both lists that use it, each row a full-width 44px+
     target. The 4px gap is the same ladder Header.astro's stacked nav uses — the link's
     own 12px of block padding is what separates the rows, not the gap. */
  .site-footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* block, not inline-block: the target is then the full column width by 50.4px, which is
     what WCAG 2.5.5's 44px floor actually asks for on both axes. inline-block made it only
     as wide as its label, and "RSS" is 31px. */
  .site-footer__link {
    display: block;
    padding-block: var(--space-12);
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .site-footer__link:hover {
    text-decoration-thickness: 2px;
  }

  .site-footer__elsewhere {
    display: grid;
    gap: var(--space-8);
  }

  .site-footer__heading {
    line-height: var(--lh-tight);
  }

  .site-footer__colophon {
    display: grid;
    gap: var(--space-8);
    font-size: var(--size-16);
  }

  .site-footer__colophon p {
    margin: 0;
  }

  @media (min-width: 48em) {
    /* Two rows, not three columns. A five-link horizontal run is 363px and the colophon's
       longest line is 274px; with the 123px lockup and two 48px gaps that is 857px of track
       in the 672px this column has at the hinge, which squeezes the colophon to ~90px and
       wraps it four ways. Brand and nav share row one (534px of 672px, 137px spare); the
       Elsewhere pair and the colophon share row two, which is why the colophon no longer
       spans both columns. DOM order is unchanged, so nothing reorders. */
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-32) var(--space-48);
      padding-block: var(--space-48) var(--space-64);
      align-items: center;
    }

    .site-footer__brand [data-mark="stacked"] {
      display: none;
    }

    .site-footer__brand [data-mark="wide"] {
      display: block;
    }

    /* nowrap for the reason the header's run is nowrap: a nav that drops a link onto a
       second line at a 24px gap is indistinguishable from a broken nav. */
    .site-footer__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: var(--space-24);
    }

    .site-footer__link {
      display: inline-block;
      padding-block: var(--space-4);
    }

    .site-footer__colophon {
      gap: var(--space-4);
      font-size: var(--text-meta);
      text-align: end;
    }
  }
</style>
