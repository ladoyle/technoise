---
// Three blocks on the wide column: brand, navigation, colophon. Stacked below the
// breakpoint, side by side above it.
//
// The brand repeats the header's logo pair on the same 48em hinge, and inherits the
// same caveat: an external SVG's dark mode follows the OS prefers-color-scheme only,
// not a future manual ThemeToggle. See Header.astro for the full rationale.
//
// TODO(human input): an "Elsewhere" block — GitHub, LinkedIn, contact — is absent on
// purpose. Those URLs are human input (setup-guide Part 5: contact preference and
// elsewhere links). The feed is not: it exists as of Phase 4 and is linked below.
// PLACEHOLDER: this footer ships with site navigation only until those URLs are
// supplied. Do not invent them.
//
// About is absent for a different reason: /about/ does not exist yet and the link
// would 404. It returns here, and to the header, when the page does.

const year = new Date().getFullYear();

const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/resume/", label: "Resume" },
  { href: "/styleguide/", label: "Styleguide" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="site-footer">
  <div class="wrap wrap--wide site-footer__inner">
    <div class="site-footer__brand">
      <picture>
        <source
          media="(min-width: 48em)"
          srcset="/brand/technoise-logo-full.svg"
        />
        <img
          src="/brand/technoise-logo-presentation.svg"
          alt="TechNoise — Hear the future"
          width="1024"
          height="1024"
        />
      </picture>
    </div>

    <nav aria-label="Footer">
      <ul class="site-footer__list">
        {
          nav.map((item) => (
            <li>
              <a class="site-footer__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__colophon">
      <p>&copy; {year} TechNoise</p>
      <p>Built with Astro. Hosted on GitHub Pages.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-96);
    border-block-start: var(--hairline) solid var(--border);
    color: var(--text-muted);
    font-size: var(--size-16);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-32);
    padding-block: var(--space-48) var(--space-64);
  }

  /* A secondary appearance, so a step below the header's 48px stacked mark. */
  .site-footer__brand img {
    inline-size: auto;
    block-size: var(--space-32);
  }

  .site-footer__list {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    display: inline-block;
    padding-block: var(--space-4);
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .site-footer__link:hover {
    text-decoration-thickness: 2px;
  }

  .site-footer__colophon {
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-meta);
  }

  .site-footer__colophon p {
    margin: 0;
  }

  @media (min-width: 48em) {
    .site-footer__inner {
      grid-template-columns: 1fr auto auto;
      gap: var(--space-48);
      align-items: start;
    }

    /*
      Up, not down, and against the intent that the footer mark reads smaller than the
      header's. The horizontal file carries so much transparent margin that 48px is the
      height at which its wordmark resolves at all; at 32px it is a smudge. Its artwork
      still lands ~half the height of the stacked mark above, so the footer reads as the
      quieter of the two — the box matches the header's only because the file forces it.
    */
    .site-footer__brand img {
      block-size: var(--space-48);
    }

    .site-footer__colophon {
      text-align: end;
    }
  }
</style>
