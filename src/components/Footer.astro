---
// Three blocks on the wide column: brand, navigation, colophon. All stacked below the
// breakpoint; above it brand and navigation share a row and the colophon takes the next
// one, because a horizontal five-link run and the colophon cannot both fit a row at 48em.
//
// The brand repeats the header's logo pair on the same 48em hinge, at the same 48px, but
// not by the same mechanism: these are still <img src> references to public/brand/, so the
// mark's dark mode comes from the prefers-color-scheme block inside the file rather than
// from this page's cascade. That is the caveat Header.astro used to share and no longer
// does — it inlines the same two files so their fills resolve through tokens.css. The
// footer therefore still carries the risk the header shed: an engine or a forced-dark
// filter that never evaluates the media query inside a referenced image renders this mark
// in light-mode ink on a dark surface. It was not reported, and fixing it was out of scope
// for the cycle that fixed the header; see Header.astro for the pattern if it is.
//
// TODO(human input): an "Elsewhere" block — GitHub, LinkedIn, contact — is absent on
// purpose. Those URLs are human input (setup-guide Part 5: contact preference and
// elsewhere links). The feed is not: it exists as of Phase 4 and is linked below.
// PLACEHOLDER: this footer ships with site navigation only until those URLs are
// supplied. Do not invent them.
//
// About is absent for a different reason: /about/ does not exist yet and the link
// would 404. It returns here, and to the header, when the page does.

const year = new Date().getFullYear();

const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
  { href: "/resume/", label: "Resume" },
  { href: "/styleguide/", label: "Styleguide" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="site-footer">
  <div class="wrap wrap--wide site-footer__inner">
    <div class="site-footer__brand">
      <picture>
        <source
          media="(min-width: 48em)"
          srcset="/brand/technoise-logo-full.svg"
          width="1319"
          height="514"
        />
        <img
          src="/brand/technoise-logo-presentation.svg"
          alt=""
          width="918"
          height="835"
        />
      </picture>
    </div>

    <nav aria-label="Footer">
      <ul class="site-footer__list">
        {
          nav.map((item) => (
            <li>
              <a class="site-footer__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__colophon">
      <p>&copy; {year} TechNoise</p>
      <p>Built with Astro. Hosted on GitHub Pages.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-96);
    border-block-start: var(--hairline) solid var(--border);
    color: var(--text-muted);
    font-size: var(--size-16);
  }

  /*
    The base rules here are the small-screen design, and the media block below reverts
    what the desktop layout should not inherit. At 320px this block is the densest on
    the site — five stacked link rows under a mark and over a colophon — so it gets the
    looser of the two sets of values, not the tighter one.
  */
  .site-footer__inner {
    display: grid;
    gap: var(--space-48);
    padding-block: var(--space-64);
  }

  /* The same 48px box as the header's mark, either side of the hinge. It used to sit one
     spacing step under, which read as small rather than as secondary — and the scale has
     no step between 32 and 48, so matching the header is the only on-scale way up. The
     mark's apparent size still changes across the hinge, because the file swaps from the
     stacked lockup to the horizontal one. */
  .site-footer__brand img {
    inline-size: auto;
    block-size: var(--space-48);
  }

  /* One column below the hinge: five stacked rows, each a full-width 44px+ target. The
     4px gap is the same ladder Header.astro's stacked nav uses — the link's own 12px of
     block padding is what separates the rows, not the gap. */
  .site-footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* block, not inline-block: the target is then the full column width by 50.4px, which is
     what WCAG 2.5.5's 44px floor actually asks for on both axes. inline-block made it only
     as wide as its label, and "RSS" is 31px. */
  .site-footer__link {
    display: block;
    padding-block: var(--space-12);
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .site-footer__link:hover {
    text-decoration-thickness: 2px;
  }

  .site-footer__colophon {
    display: grid;
    gap: var(--space-8);
    font-size: var(--size-16);
  }

  .site-footer__colophon p {
    margin: 0;
  }

  @media (min-width: 48em) {
    /* Two rows, not three columns. A five-link horizontal run is 363px and the colophon's
       longest line is 274px; with the 123px lockup and two 48px gaps that is 857px of track
       in the 672px this column has at the hinge, which squeezes the colophon to ~90px and
       wraps it four ways. Brand and nav share row one (534px of 672px, 137px spare); the
       colophon takes row two. DOM order is unchanged, so nothing reorders. */
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-32) var(--space-48);
      padding-block: var(--space-48) var(--space-64);
      align-items: center;
    }

    /* nowrap for the reason the header's run is nowrap: a nav that drops a link onto a
       second line at a 24px gap is indistinguishable from a broken nav. */
    .site-footer__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: var(--space-24);
    }

    .site-footer__link {
      display: inline-block;
      padding-block: var(--space-4);
    }

    .site-footer__colophon {
      grid-column: 1 / -1;
      gap: var(--space-4);
      font-size: var(--text-meta);
      text-align: end;
    }
  }
</style>
