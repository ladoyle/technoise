---
// The inventory's "SEO head block": everything in <head> a crawler or a social
// client reads, in one place. JSON-LD lives here behind a `schema` prop rather than
// in a second component — a second <script> tag with identical props source,
// identical consumers and identical lifecycle would be a thirteenth component for
// no gain.
//
// This component never composes a title. The caller passes the finished <title>,
// because two places composing titles is how a duplicate appears.

import { isoDate } from "../lib/content";
import { OG_IMAGE, RSS_PATH, SITE, absoluteUrl, assertMetaBudget, jsonLdSafe } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: { src: string; alt: string; width: number; height: number };
  article?: { published: Date; modified?: Date; tags: string[] };
  prevPath?: string;
  nextPath?: string;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  ogType = "website",
  ogImage = OG_IMAGE,
  article,
  prevPath,
  nextPath,
  schema = [],
} = Astro.props;

assertMetaBudget(title, description, canonicalPath);

const canonical = absoluteUrl(canonicalPath, Astro.site);
const imageUrl = absoluteUrl(ogImage.src, Astro.site);
const feedUrl = absoluteUrl(RSS_PATH, Astro.site);
---

<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
/>

{prevPath && <link rel="prev" href={absoluteUrl(prevPath, Astro.site)} />}
{nextPath && <link rel="next" href={absoluteUrl(nextPath, Astro.site)} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content={OG_IMAGE.type} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />

{
  article && (
    <>
      <meta property="article:published_time" content={isoDate(article.published)} />
      {article.modified && (
        <meta property="article:modified_time" content={isoDate(article.modified)} />
      )}
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={ogImage.alt} />

<link rel="alternate" type="application/rss+xml" title={SITE.name} href={feedUrl} />

{
  schema.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLdSafe({ "@context": "https://schema.org", "@graph": schema })}
    />
  )
}
