---
// The page shell: the document skeleton, the stylesheet graph, the font preload and
// the landmark structure. It owns <title> and the meta description; everything else
// a crawler or social client reads — canonical, robots, Open Graph, Twitter card,
// the feed link and JSON-LD — belongs to <SeoHead>, which this layout feeds.
//
// A page that passes no `canonicalPath` gets one derived from its own URL, so a new
// route is canonical by default rather than by remembering.

import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import { canonicalPath as toCanonicalPath } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
  ogType?: "website" | "article";
  article?: { published: Date; modified?: Date; tags: string[] };
  prevPath?: string;
  nextPath?: string;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  canonicalPath,
  ogType,
  article,
  prevPath,
  nextPath,
  schema,
} = Astro.props;

const path = canonicalPath ?? toCanonicalPath(Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* crossorigin is required even for a same-origin font preload. */}
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SeoHead
      title={title}
      description={description}
      canonicalPath={path}
      noindex={noindex}
      ogType={ogType}
      article={article}
      prevPath={prevPath}
      nextPath={nextPath}
      schema={schema}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
