---
import type { GetStaticPaths, Page } from "astro";

import ListingLayout from "../../layouts/ListingLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import {
  PAGE_SIZE,
  collectTags,
  getPublishedPosts,
  readingMinutes,
  type Post,
  type TagCount,
} from "../../lib/content";
import { canonicalPath, pageTitle } from "../../lib/seo";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getPublishedPosts();

  return paginate(posts, {
    pageSize: PAGE_SIZE,
    props: { tags: collectTags(posts) },
  });
};

interface Props {
  page: Page<Post>;
  tags: TagCount[];
}

const { page, tags } = Astro.props;

const title =
  page.currentPage > 1 ? pageTitle(`Blog, page ${page.currentPage}`) : pageTitle("Blog");
// A sentence of its own rather than a dangling " — page 2" clause, which reads as
// truncation in a search snippet.
const suffix = page.currentPage > 1 ? ` Page ${page.currentPage}.` : "";
const description = `Notes on current software, patterns, and projects: code examples, lessons learned, and the AI systems built along the way.${suffix}`;

// Google dropped rel=prev/next as an indexing signal in 2019; Bing still reads it,
// and it costs two tags. The canonical stays self-referential either way — pointing
// page 2 at page 1 would tell a crawler the posts only on page 2 do not exist.
const linkRel = (href: string | undefined): string | undefined =>
  href ? canonicalPath(new URL(href, Astro.url)) : undefined;
---

<ListingLayout
  title={title}
  description={description}
  heading="Blog"
  lede="Notes on the software technologies and patterns shaping the work — code from real projects, lessons learned, best practices, and the AI systems built along the way."
  tags={tags}
  prevPath={linkRel(page.url.prev)}
  nextPath={linkRel(page.url.next)}
>
  {
    page.data.length === 0 ? (
      <p class="listing-empty">No posts yet.</p>
    ) : (
      page.data.map((post) => (
        <PostCard
          title={post.data.title}
          href={`/blog/${post.id}/`}
          description={post.data.description}
          pubDate={post.data.pubDate}
          minutes={readingMinutes(post.body)}
          tags={post.data.tags}
          headingLevel={2}
        />
      ))
    )
  }

  <Pagination
    slot="pagination"
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={linkRel(page.url.prev)}
    nextUrl={linkRel(page.url.next)}
    label="Blog pagination"
  />
</ListingLayout>

<style>
  .listing-empty {
    margin: 0;
    padding-block: var(--space-32);
    color: var(--text-muted);
    font-size: var(--size-18);
  }
</style>
