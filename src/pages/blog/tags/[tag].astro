---
import type { GetStaticPaths } from "astro";

import ListingLayout from "../../../layouts/ListingLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import {
  collectTags,
  getPublishedPosts,
  readingMinutes,
  type Post,
  type TagCount,
} from "../../../lib/content";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts);

  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      tags,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
};

interface Props {
  tag: string;
  tags: TagCount[];
  posts: Post[];
}

const { tag, tags, posts } = Astro.props;
---

<ListingLayout
  title={`Posts tagged ${tag} — TechNoise`}
  description={`Every TechNoise post tagged ${tag}.`}
  heading={`Posts tagged ${tag}`}
  lede={`Every post on this site filed under ${tag}, newest first.`}
  tags={tags}
  activeTag={tag}
>
  {
    posts.map((post) => (
      <PostCard
        title={post.data.title}
        href={`/blog/${post.id}/`}
        description={post.data.description}
        pubDate={post.data.pubDate}
        minutes={readingMinutes(post.body)}
        tags={post.data.tags}
        headingLevel={2}
      />
    ))
  }
</ListingLayout>
