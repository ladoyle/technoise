---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import PostLayout from "../../layouts/PostLayout.astro";
import { getPublishedPosts, type Post } from "../../lib/content";

// Neighbours are resolved here, from the same sorted array the listing uses, so the
// layout never queries the collection itself.
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
};

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} newer={newer} older={older}>
  <Content />
</PostLayout>
