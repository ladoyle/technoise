---
// The front door. A first-time visitor arriving at / with no context gets one
// sentence about what this is and three places to go next — not a design-system
// memo, which is what this page used to be. That material moved to /styleguide/,
// where the reasoning and the specimens now sit together.
//
// TODO(human input): the hero still carries no positioning sentence — what the owner
// builds and who it is for is human input (setup-guide Part 5) and is not invented
// here. The copy below describes the site's contents, which is a repo-authored fact.
//
// The artwork is decorative: alt="" because the hero's meaning is entirely in the
// text beside it, and a description of the mascot would be noise between the H1 and
// the calls to action. It is laid under a flat --surface scrim at --scrim-opacity so
// the contrast of text over it is a known quantity rather than a guess — the worst
// pixel of the art puts body text at 7.4:1 light and 7.5:1 dark. The scrim is plain
// opacity, not color-mix(), because an unsupported color-mix() falls back to
// transparent and the failure mode is unreadable text.

import { Picture } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, absoluteUrl } from "../lib/seo";
import heroArt from "../assets/technoise-background.png";

const home = absoluteUrl("/", Astro.site);
const personId = `${home}#person`;

const schema = [
  {
    "@type": "WebSite",
    "@id": `${home}#website`,
    name: SITE.name,
    url: home,
    description: SITE.description,
    inLanguage: SITE.locale,
    publisher: { "@id": personId },
  },
  {
    "@type": "Person",
    "@id": personId,
    name: SITE.author.name,
    url: home,
    sameAs: SITE.author.sameAs,
  },
];
---

<BaseLayout
  title="TechNoise"
  description="A personal blog and project log: posts about how this site is built, the projects behind it, and a resume."
  schema={schema}
>
  <section class="hero">
    <Picture
      src={heroArt}
      alt=""
      widths={[640, 960, 1280, 1536]}
      sizes="100vw"
      formats={["avif", "webp"]}
      loading="eager"
      fetchpriority="high"
      class="hero__art"
    />

    <div class="wrap wrap--wide hero__inner">
      <div class="hero__text">
        <h1 class="hero__title">A blog and a project log</h1>
        <p class="hero__lede">
          A personal site for writing and projects. Start with the posts, look through
          the projects, or read the resume.
        </p>
        <p class="hero__actions">
          <a class="button" href="/blog/">Read the blog</a>
          <a class="button button--ghost" href="/projects/">See the projects</a>
          <a class="button button--ghost" href="/resume/">Read the resume</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    The negative top margin cancels main's opening padding so the art sits flush under
    the header instead of floating in a band of page colour. isolation keeps the two
    negative-z-index layers inside the hero's own stacking context.
  */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(var(--space-48) * -1);
    padding-block: var(--space-64);
  }

  .hero__art {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface);
    opacity: var(--scrim-opacity);
  }

  /* No muted text anywhere in here: --text-muted over the worst composite under the
     scrim measures 3.5:1 and fails. Everything in the hero is full --text. */
  .hero__text {
    max-width: var(--content);
  }

  .hero__title {
    margin: 0;
    font-size: var(--text-hero);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__lede {
    margin: var(--space-24) 0 0;
    color: var(--text);
    font-size: var(--text-h3);
    line-height: var(--lh-body);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: var(--space-32) 0 0;
  }

  /* A ghost label is --link on whatever shows through, which over the bare scrim is
     3.1:1 and fails. An opaque surface fill under it restores 5.4:1 light, 7.2:1 dark
     without touching the shared button rules in global.css. */
  .hero .button--ghost {
    background: var(--surface);
  }

  @media (min-width: 48em) {
    .hero {
      padding-block: var(--space-96);
    }

    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
