---
// The front door. A first-time visitor arriving at / with no context gets one
// sentence about what this is and three places to go next — not a design-system
// memo, which is what this page used to be. That material moved to /styleguide/,
// where the reasoning and the specimens now sit together.
//
// The lede's positioning derives from RESUME.focus in src/lib/resume.ts — human-authored
// and already public on /resume/ — rather than being invented here. It stays literal
// prose instead of interpolating that field: RESUME.focus is a capitalised fragment
// ending in a period, and splicing it mid-sentence would mean lowercasing and trimming
// it at build time, which is brittle string surgery for one line. The cost is that the
// positioning now lives in two places; keep them in step.
//
// The lede opens on the brand, not the owner's name, and closes on the brand tagline
// already set in the logo lockup's .tn-tagline and rendered in the header and footer of
// every page. Neither is a new claim, and the person behind it is named on /resume/.
//
// The artwork is decorative: alt="" because the hero's meaning is entirely in the
// text beside it, and a description of the mascot would be noise between the H1 and
// the calls to action. It is laid under a flat --surface scrim at --scrim-opacity so
// the contrast of text over it is a known quantity rather than a guess — composited
// output stays above 6.5:1 in both schemes across viewport widths. The scrim is plain
// opacity, not color-mix(), because an unsupported color-mix() falls back to
// transparent and the failure mode is unreadable text.

import { Picture } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPublishedPosts, getPublishedProjects, readingMinutes } from "../lib/content";
import { SITE, absoluteUrl } from "../lib/seo";
import heroArt from "../assets/technoise-background.png";

// A hero on its own would be a splash screen hiding the two posts and the project
// that already exist one click away, for no saving. The slices are the teaser, not
// the archive — /blog/ and /projects/ are a link below each run.
const posts = (await getPublishedPosts()).slice(0, 3);
const projects = (await getPublishedProjects()).slice(0, 2);

const home = absoluteUrl("/", Astro.site);
const personId = `${home}#person`;

const schema = [
  {
    "@type": "WebSite",
    "@id": `${home}#website`,
    name: SITE.name,
    url: home,
    description: SITE.description,
    inLanguage: SITE.locale,
    publisher: { "@id": personId },
  },
  {
    "@type": "Person",
    "@id": personId,
    name: SITE.author.name,
    url: home,
    sameAs: SITE.author.sameAs,
  },
];
---

<BaseLayout
  title="TechNoise"
  description="A personal blog and project log: posts about how this site is built, the projects behind it, and a resume."
  schema={schema}
>
  <section class="hero">
    <Picture
      src={heroArt}
      alt=""
      widths={[640, 960, 1280, 1536]}
      sizes="100vw"
      formats={["avif", "webp"]}
      loading="eager"
      fetchpriority="high"
      class="hero__art"
    />

    <div class="wrap wrap--wide hero__inner">
      <div class="hero__text">
        <h1 class="hero__title">A blog and a project log</h1>
        <p class="hero__lede">
          TechNoise — distributed systems, cloud engineering, AI-assisted development.
          Start with the posts, look through the projects, hear the future.
        </p>
        <p class="hero__actions">
          <a class="button" href="/blog/">Read the blog</a>
          <a class="button button--ghost" href="/projects/">See the projects</a>
          <a class="button button--ghost" href="/resume/">Read the resume</a>
        </p>
      </div>
    </div>
  </section>

  <div class="wrap wrap--wide">
    <section>
      <h2 class="teaser__title">Latest posts</h2>
      {
        posts.length === 0 ? (
          <p class="teaser__empty">No posts yet.</p>
        ) : (
          <div class="teaser__posts">
            {posts.map((post) => (
              <PostCard
                title={post.data.title}
                href={`/blog/${post.id}/`}
                description={post.data.description}
                pubDate={post.data.pubDate}
                minutes={readingMinutes(post.body)}
                tags={post.data.tags}
                headingLevel={3}
              />
            ))}
          </div>
        )
      }
      <p class="teaser__more">
        <a href="/blog/">All posts <span aria-hidden="true">&rarr;</span></a>
      </p>
    </section>

    <section>
      <h2 class="teaser__title">Projects</h2>
      {
        projects.length === 0 ? (
          <p class="teaser__empty">No projects yet.</p>
        ) : (
          <div class="teaser__grid">
            {projects.map((project) => (
              <ProjectCard
                title={project.data.title}
                href={`/projects/${project.id}/`}
                description={project.data.description}
                stack={project.data.stack}
                status={project.data.status}
                headingLevel={3}
              />
            ))}
          </div>
        )
      }
      <p class="teaser__more">
        <a href="/projects/">All projects <span aria-hidden="true">&rarr;</span></a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /*
    The negative top margin cancels main's opening padding so the art sits flush under
    the header instead of floating in a band of page colour. isolation keeps the two
    negative-z-index layers inside the hero's own stacking context.
  */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(var(--space-48) * -1);
    padding-block: var(--space-64);
  }

  .hero__art {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface);
    opacity: var(--scrim-opacity);
  }

  /* No muted text anywhere in here: --text-muted over the worst composite under the
     scrim measures 3.5:1 and fails. Everything in the hero is full --text. */
  .hero__text {
    max-width: var(--content);
  }

  .hero__title {
    margin: 0;
    font-size: var(--text-hero);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__lede {
    margin: var(--space-24) 0 0;
    color: var(--text);
    font-size: var(--text-h3);
    line-height: var(--lh-body);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: var(--space-32) 0 0;
  }

  /* A ghost label is --link on whatever shows through, which over the bare scrim is
     3.1:1 and fails. An opaque surface fill under it restores 5.4:1 light, 7.2:1 dark
     without touching the shared button rules in global.css. */
  .hero .button--ghost {
    background: var(--surface);
  }

  /* Restated inside the hero's scope because the rule above is scoped to (0,4,0) and
     would otherwise outrank the shared (0,2,0) .button--ghost:hover in global.css,
     leaving these two CTAs with no pointer feedback at all. */
  .hero .button--ghost:hover {
    background: var(--surface-sunken);
  }

  .teaser__title {
    margin-block: var(--space-96) var(--space-24);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
  }

  /* Each PostCard draws its own top rule, so the run needs closing at the bottom
     the same way the blog listing closes it. */
  .teaser__posts {
    border-block-end: var(--hairline) solid var(--border);
  }

  .teaser__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    gap: var(--space-32);
  }

  .teaser__empty {
    margin: 0;
    padding-block: var(--space-32);
    color: var(--text-muted);
    font-size: var(--size-18);
  }

  /* A plain link, not a button: the hero's primary CTA is the page's one orange. */
  .teaser__more {
    margin: var(--space-32) 0 0;
  }

  .teaser__more a {
    color: var(--link);
    font-size: var(--size-18);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .teaser__more a:hover {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 48em) {
    .hero {
      padding-block: var(--space-96);
    }

    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .teaser__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
