---
// The resume as a document, not a landing page: one 720px column, four sections, and
// the two contact channels the owner has published. Every string, date and profile
// link comes from src/lib/resume.ts, so the visible sections and the structured data
// below cannot disagree — and so the privacy rule that module's types enforce (no
// phone number, no location) holds for this page's metadata too.
//
// print.css is imported here and on no other route. Ctrl+P is the PDF, which is why
// there is no download button and no committed resume file to drift from this page.

import BaseLayout from "../layouts/BaseLayout.astro";
import TagPill from "../components/TagPill.astro";
import { RESUME, formatMonth, profiles } from "../lib/resume";
import { SITE, absoluteUrl, pageTitle } from "../lib/seo";
import "../styles/print.css";

const title = pageTitle("Luke Doyle — Resume");
const description =
  "Lead Software Engineer with 6+ years building distributed APIs and data pipelines serving millions of customers — experience, skills and education.";

const home = absoluteUrl("/", Astro.site);
// The same id the home page emits, so the site describes one person, not two.
const personId = `${home}#person`;
const resumeUrl = absoluteUrl("/resume/", Astro.site);

// Glyphs: Bootstrap Icons, MIT (https://github.com/twbs/icons). The path data is copied
// rather than depended on — three marks on one route do not justify a package, and they
// are presentation, so the map lives here rather than in resume.ts.
//
// Keyed by the same labels `profiles` produces: a host with no entry here renders as a
// plain text link rather than under a guessed mark, the same way resume.ts drops a host
// with no label rather than inventing one.
const CONTACT_ICONS: Record<string, string> = {
  Email:
    "M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z",
  LinkedIn:
    "M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z",
  GitHub:
    "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8",
};

const contacts = [
  { label: "Email", text: RESUME.email, href: `mailto:${RESUME.email}` },
  ...profiles.map((profile) => ({
    label: profile.label,
    text: profile.label,
    href: profile.href,
  })),
];

const schema = [
  {
    "@type": "ProfilePage",
    "@id": `${resumeUrl}#profilepage`,
    url: resumeUrl,
    name: title,
    inLanguage: SITE.locale,
    mainEntity: { "@id": personId },
  },
  {
    "@type": "Person",
    "@id": personId,
    name: SITE.author.name,
    url: home,
    sameAs: SITE.author.sameAs,
    jobTitle: RESUME.title,
    email: `mailto:${RESUME.email}`,
    knowsAbout: RESUME.skills.flatMap((group) => group.items),
    alumniOf: RESUME.education.map((degree) => ({
      "@type": "EducationalOrganization",
      name: degree.institution,
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="wrap">
    <header class="resume__masthead">
      <p class="eyebrow">Resume</p>
      <h1 class="resume__name">{RESUME.name}</h1>
      <p class="resume__role-line">{RESUME.title}</p>
      <p class="resume__focus">{RESUME.focus}</p>
      <ul class="resume__contact">
        {
          contacts.map((contact) => (
            <li>
              <a href={contact.href}>
                {CONTACT_ICONS[contact.label] && (
                  <svg
                    class="resume__icon"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={CONTACT_ICONS[contact.label]} />
                  </svg>
                )}
                <span class="resume__contact-label">{contact.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <section class="resume__section" aria-labelledby="summary">
      <h2 class="resume__heading" id="summary">Summary</h2>
      <p class="resume__summary">{RESUME.summary}</p>
    </section>

    <section class="resume__section" aria-labelledby="experience">
      <h2 class="resume__heading" id="experience">Experience</h2>
      <ol class="resume__roles">
        {
          RESUME.roles.map((role) => (
            <li class="resume__role">
              <h3 class="resume__role-title">{role.title}</h3>
              <p class="resume__role-meta">
                <span class="resume__org">{role.org}</span>
                <span aria-hidden="true">·</span>
                <span class="resume__dates">
                  {role.periods.map((period, index) => (
                    <Fragment>
                      {index > 0 && ", "}
                      <time datetime={period.start}>{formatMonth(period.start)}</time>
                      <span class="visually-hidden"> to </span>
                      <span aria-hidden="true"> – </span>
                      {period.end ? (
                        <time datetime={period.end}>{formatMonth(period.end)}</time>
                      ) : (
                        "Present"
                      )}
                    </Fragment>
                  ))}
                </span>
              </p>
              {role.bullets.length > 0 && (
                <ul class="resume__bullets">
                  {role.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
      <p class="resume__more">
        Projects are written up separately —{" "}
        <a href="/projects/">see the project log <span aria-hidden="true">&rarr;</span></a>
      </p>
    </section>

    <section class="resume__section" aria-labelledby="skills">
      <h2 class="resume__heading" id="skills">Skills</h2>
      <dl class="resume__skills">
        {
          RESUME.skills
            .filter((group) => group.items.length > 0)
            .map((group) => (
              <div class="resume__skill-group">
                <dt class="eyebrow">{group.label}</dt>
                <dd>
                  <ul class="resume__skill-list">
                    {group.items.map((item) => (
                      <li>
                        <TagPill label={item} />
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
        }
      </dl>
    </section>

    <section class="resume__section" aria-labelledby="education">
      <h2 class="resume__heading" id="education">Education</h2>
      <ul class="resume__education">
        {
          RESUME.education.map((degree) => (
            <li class="resume__degree">
              <h3 class="resume__role-title">{degree.credential}</h3>
              <p class="resume__role-meta">
                <span class="resume__org">{degree.institution}</span>
                <span aria-hidden="true">·</span>
                <span class="resume__dates">
                  <time datetime={degree.period.start}>{formatMonth(degree.period.start)}</time>
                  <span class="visually-hidden"> to </span>
                  <span aria-hidden="true"> – </span>
                  {degree.period.end ? (
                    <time datetime={degree.period.end}>{formatMonth(degree.period.end)}</time>
                  ) : (
                    "Present"
                  )}
                </span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .resume__masthead {
    padding-block-end: var(--space-32);
    /* The page's one orange, as a rule rather than a button: a document's reader
       wants content in the first screen, not three controls. */
    border-block-end: 2px solid var(--accent-fill);
  }

  .resume__name {
    margin: var(--space-8) 0 0;
    font-size: var(--text-h1);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: break-word;
  }

  .resume__role-line {
    margin: var(--space-8) 0 0;
    font-size: var(--text-h3);
    line-height: var(--lh-body);
  }

  .resume__focus {
    margin: var(--space-8) 0 0;
    color: var(--text-muted);
    font-size: var(--size-16);
  }

  .resume__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin: var(--space-24) 0 0;
    padding: 0;
    font-size: var(--size-16);
    list-style: none;
  }

  /* The underline moves to the label so it does not run under the glyph; the link keeps
     one focus ring and one hit area around both. */
  .resume__contact a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-8);
    color: var(--link);
    text-decoration: none;
  }

  .resume__contact-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .resume__contact a:hover .resume__contact-label {
    text-decoration-thickness: 2px;
  }

  .resume__icon {
    flex: 0 0 auto;
    inline-size: var(--space-24);
    block-size: var(--space-24);
  }

  .resume__heading {
    margin-block: var(--space-64) var(--space-24);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
  }

  /* Each entry draws its own top rule, so the run needs closing at the bottom — the
     rhythm PostCard already sets on /blog/. */
  .resume__roles,
  .resume__education {
    margin: 0;
    padding: 0;
    border-block-end: var(--hairline) solid var(--border);
    list-style: none;
  }

  .resume__role,
  .resume__degree {
    padding-block: var(--space-32);
    border-block-start: var(--hairline) solid var(--border);
  }

  .resume__role-title {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: break-word;
  }

  .resume__role-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4) var(--space-8);
    margin: var(--space-8) 0 0;
    font-size: var(--size-16);
    line-height: var(--lh-tight);
  }

  .resume__org {
    font-weight: var(--weight-medium);
  }

  .resume__dates {
    color: var(--text-muted);
    font-size: var(--text-meta);
  }

  .resume__summary {
    margin: 0;
    font-size: var(--text-body);
  }

  .resume__bullets {
    margin: var(--space-16) 0 0;
    padding-inline-start: var(--space-24);
    font-size: var(--text-body);
  }

  .resume__bullets li + li {
    margin-block-start: var(--space-8);
  }

  .resume__bullets li::marker {
    color: var(--text-muted);
  }

  .resume__more {
    margin: var(--space-32) 0 0;
    font-size: var(--size-18);
  }

  .resume__more a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .resume__more a:hover {
    text-decoration-thickness: 2px;
  }

  .resume__skills {
    display: grid;
    gap: var(--space-24);
    margin: 0;
  }

  /* .eyebrow supplies the label's type; this is only its rhythm. */
  .resume__skill-group dt {
    margin-block-end: var(--space-12);
  }

  .resume__skill-group dd {
    margin: 0;
  }

  .resume__skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
