---
// The site's one technical page: the reasoning behind the design system and the
// specimen sheet for it, together. Every token, every scale step and every
// interactive state on one surface, each under the argument for why it is that value,
// so a change to the system can be eyeballed and justified in one place instead of
// hunted for across pages. The narrative arrived here from the home page, which now
// has a job of its own.
//
// noindex, and excluded from the sitemap in Phase 4 — the SEO score is 100 or it is
// a defect, and an indexed swatch grid is not a page anyone searched for. noindex is
// not unlinkable: the header and footer both link here.
//
// The swatch captions come from src/lib/palette.ts, never from literals here: the chip
// renders live from the token, so a hand-typed hex or ratio beside it would go stale
// against the very colour it labels. The ratios there are computed, not transcribed.
//
// This page shows orange more than once, and the exemption survives the narrative.
// The "orange appears once per screen" rule governs a composed page, where orange
// marks the one thing to do. Here the palette is the subject, not the chrome — the
// orange on this page is a specimen being described, and describing it is precisely
// what the added prose does.

import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/Prose.astro";
import TagPill from "../components/TagPill.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Pagination from "../components/Pagination.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { SWATCHES } from "../lib/palette";

// Literal props, never a collection query: the specimen sheet has to keep building
// when src/content/ is empty.
const specimenDate = new Date("2026-09-15T00:00:00Z");

const typeSteps = [
  { token: "--size-49", px: 49, use: "Home hero, desktop" },
  { token: "--size-39", px: 39, use: "H1 desktop / hero mobile" },
  { token: "--size-31", px: 31, use: "H1 mobile / H2 desktop" },
  { token: "--size-25", px: 25, use: "H2 mobile / H3 desktop" },
  { token: "--size-20", px: 20, use: "Body desktop, H3 mobile" },
  { token: "--size-18", px: 18, use: "Body mobile" },
  { token: "--size-16", px: 16, use: "Nav, code, tables" },
  { token: "--size-14", px: 14, use: "Meta, captions" },
];

const spaceSteps = [4, 8, 12, 16, 24, 32, 48, 64, 96];
---

<BaseLayout
  title="Styleguide — TechNoise"
  description="Why the TechNoise palette, type scale and spacing scale are what they are, with every token, scale step and interactive state on one page."
  noindex
>
  <div class="wrap wrap--wide">
    <p class="eyebrow">Reference</p>
    <h1 class="sg-title">Styleguide</h1>
    <p class="sg-lede">
      Contrast ratios are measured against the page colour of the scheme they belong
      to, light first. Nothing here should ever need a value outside the scales.
    </p>

    <Prose class="sg-narrow">
      <p>
        The page is cream, never white. Pure white next to <code>#FDF9F3</code> reads
        as a rendering bug, so the surface token resolves to cream in the light scheme
        and to ink in the dark one. Body text is ink on cream at 12.9:1, which clears
        AAA with room to spare, and the column is capped at 720px so a line lands
        between 68 and 72 characters at the desktop body size.
      </p>

      <blockquote>
        <p>
          Editorial layout, generous whitespace, one column of readable text. No
          cards-in-cards, no gradients, no shadow deeper than a hairline.
        </p>
      </blockquote>
    </Prose>

    <h2 class="sg-h2" id="colour">Colour</h2>
    <Prose class="sg-narrow">
      <p>
        Body links use the darkened signal blue at 5.4:1, never the raw brand blue,
        which measures 4.1:1 and fails. They are <a href="#states">underlined
        as well as coloured</a>, because colour alone is not an affordance. Raw orange
        is a fill, never text on cream.
      </p>

      <p>
        The home hero lays the page colour over the mascot artwork at
        <code>--scrim-opacity</code> — 72% in the light scheme, 86% in the dark one.
        Measured against composited output across viewport widths, body text stays
        above 6.5:1 in both schemes.
      </p>
    </Prose>
    <ul class="sg-swatches">
      {
        SWATCHES.map((c) => (
          <li class="sg-swatch">
            <span class="sg-chip" style={`background: var(${c.token})`} aria-hidden="true" />
            <code>{c.token}</code>
            <span class="sg-role">{c.role}</span>
            <span class="sg-meta">
              {c.light} / {c.dark}
            </span>
            <span class="sg-meta">{c.ratio}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="sg-h2" id="type">Type scale</h2>
    <Prose class="sg-narrow">
      <ul>
        <li>Two families: Inter for everything, the platform mono for code.</li>
        <li>Body 18px on mobile, 20px from 768px up.</li>
        <li>Line height 1.65 for body, 1.2 for headings.</li>
        <li>One breakpoint, declared in em so it survives page zoom.</li>
      </ul>
    </Prose>
    <ul class="sg-type">
      {
        typeSteps.map((t) => (
          <li>
            <span class="sg-specimen" style={`font-size: var(${t.token})`}>
              Hear the future
            </span>
            <span class="sg-meta">
              <code>{t.token}</code> · {t.px}px · {t.use}
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="sg-h2" id="space">Spacing scale</h2>
    <Prose class="sg-narrow">
      <p>
        Vertical space comes from one scale: 4, 8, 12, 16, 24, 32, 48, 64, 96. Paragraphs
        are separated by 24px, a heading opens with 64px above it, and the footer sits
        96px below the last block. Nothing is nudged by an odd pixel.
      </p>
    </Prose>
    <ul class="sg-space">
      {
        spaceSteps.map((s) => (
          <li>
            <span class="sg-bar" style={`inline-size: var(--space-${s})`} aria-hidden="true" />
            <span class="sg-meta">
              <code>--space-{s}</code>
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="sg-h2" id="states">States</h2>

    <h3 class="sg-h3">Buttons</h3>
    <p class="sg-row">
      <a class="button" href="#states">Primary</a>
      <a class="button button--ghost" href="#states">Ghost</a>
      <button class="button" type="button" disabled>Disabled</button>
    </p>
    <p class="sg-meta">
      Tab to each. Hover each. The primary label is ink on raw pulse at 4.2:1, which
      holds because it is never smaller than 25px — large text at any weight, 3:1
      floor. Weight is not part of the guarantee: before the webfont arrives the
      label renders in whatever bold face the reader's machine has, or in none.
      Hover darkens the fill to <code>--pulse-700</code> and flips the label to
      cream at 5.1:1.
    </p>

    <h3 class="sg-h3">Links</h3>
    <Prose class="sg-prose">
      <p>
        A <a href="#states">default link</a>, and the same link after you hover it.
        Tab through this paragraph to see the focus ring: 2px solid <code>--focus</code>
        at 2px offset, which clears the 3:1 non-text floor on both the page and the
        sunken surface.
      </p>
    </Prose>

    <h2 class="sg-h2" id="components">Components</h2>

    <h3 class="sg-h3">TagPill</h3>
    <p class="sg-row">
      <TagPill label="astro" href="#components" />
      <TagPill label="design-systems" href="#components" count={4} />
      <TagPill label="accessibility" href="#components" current />
      <TagPill label="TypeScript" />
      <TagPill label="Markdown" />
    </p>
    <p class="sg-meta">
      Link, link with count, <code>aria-current="page"</code>, then two static chips.
      Hover and tab each. Both forms share one box, so a stack badge and a tag link
      never differ in size. The count is announced as "design-systems 4 posts".
    </p>

    <h3 class="sg-h3">PostCard</h3>
    <div class="sg-narrow sg-cards">
      <PostCard
        title="A post with tags"
        href="#components"
        description="The card is an editorial entry, not a box: one hairline above it and nothing else."
        pubDate={specimenDate}
        minutes={6}
        tags={["astro", "meta"]}
        headingLevel={3}
      />
      <PostCard
        title="A post with no tags at all"
        href="#components"
        description="The tag row is omitted rather than rendering an empty list."
        pubDate={specimenDate}
        minutes={1}
        tags={[]}
        headingLevel={3}
      />
    </div>

    <h3 class="sg-h3">ProjectCard</h3>
    <div class="sg-grid">
      <ProjectCard
        title="An in-progress project"
        href="#components"
        description="Status, title, one-line pitch, stack badges. Only the title is interactive."
        stack={["Astro", "TypeScript", "CSS"]}
        status="in-progress"
        headingLevel={3}
      />
      <ProjectCard
        title="A shipped project"
        href="#components"
        description="A longer pitch, here to show that the badges still land on the same baseline as the card beside it."
        stack={["Markdown"]}
        status="shipped"
        headingLevel={3}
      />
      <ProjectCard
        title="An archived project"
        href="#components"
        description="Archived is the third and last status value."
        stack={["GitHub Actions", "CSS"]}
        status="archived"
        headingLevel={3}
      />
    </div>

    <h3 class="sg-h3">Pagination</h3>
    <div class="sg-narrow">
      <Pagination currentPage={1} lastPage={3} nextUrl="#components" label="First page example" />
      <Pagination
        currentPage={2}
        lastPage={3}
        prevUrl="#components"
        nextUrl="#components"
        label="Middle page example"
      />
      <Pagination currentPage={3} lastPage={3} prevUrl="#components" label="Last page example" />
    </div>
    <p class="sg-meta">
      A missing neighbour omits its cell rather than greying out a link. At one page
      the component renders nothing at all, which is why there is no fourth example.
    </p>

    <h3 class="sg-h3">Breadcrumb</h3>
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Blog" }]} />
    <Breadcrumb
      items={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog/" },
        { label: "A post title long enough to wrap the trail onto a second line" },
      ]}
    />

    <h2 class="sg-h2" id="prose">Prose</h2>
    <Prose class="sg-narrow">
      <p>
        Inline code such as <code>--space-24</code> sits on a sunken surface at 11.6:1.
        A block runs to the gutter edges below the breakpoint rather than squeezing an
        already narrow column, and scrolls horizontally when it has to.
      </p>
    </Prose>
    <div class="sg-narrow">
      <Prose>
        <h2>A second-level heading</h2>
        <p>
          Body copy at the current breakpoint's size, 1.65 line height, capped at the
          720px column so the measure stays readable.
        </p>
        <h3>A third-level heading</h3>
        <ul>
          <li>List item with a <code>--token</code> in it.</li>
          <li>A second item, 8px below the first.</li>
        </ul>
        <blockquote>
          <p>A quote, marked by a 3px rule in the signal blue.</p>
        </blockquote>
        <pre tabindex="0"><code>--space-24: 1.5rem;</code></pre>
      </Prose>
    </div>
  </div>
</BaseLayout>

<style>
  .sg-title {
    margin: var(--space-8) 0 0;
    font-size: var(--text-h1);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
  }

  .sg-lede {
    max-width: var(--content);
    margin-block: var(--space-16) 0;
    color: var(--text-muted);
    font-size: var(--text-h3);
  }

  .sg-h2 {
    margin-block: var(--space-96) var(--space-24);
    padding-block-end: var(--space-8);
    border-block-end: var(--hairline) solid var(--border);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
  }

  .sg-h3 {
    margin-block: var(--space-48) var(--space-16);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-tight);
  }

  .sg-meta {
    color: var(--text-muted);
    font-size: var(--text-meta);
  }

  .sg-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    margin: 0 0 var(--space-16);
  }

  .sg-swatches,
  .sg-type,
  .sg-space {
    display: grid;
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sg-swatches {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .sg-swatch {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-16);
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-md);
  }

  .sg-chip {
    display: block;
    block-size: var(--space-48);
    margin-block-end: var(--space-8);
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-sm);
  }

  .sg-role {
    font-size: var(--size-16);
    font-weight: var(--weight-semibold);
  }

  .sg-type li,
  .sg-space li {
    display: grid;
    gap: var(--space-4);
  }

  .sg-specimen {
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    overflow-wrap: break-word;
  }

  .sg-space li {
    grid-template-columns: 6rem 1fr;
    align-items: center;
    gap: var(--space-16);
  }

  .sg-bar {
    display: block;
    block-size: var(--space-16);
    border-radius: var(--radius-sm);
    background: var(--rule);
  }

  .sg-narrow {
    max-width: var(--content);
  }

  /* prose.css deliberately gives a .prose block no trailing margin — nothing owns
     the space after itself. The narrative blocks are the one place on this page
     where that leaves reasoning touching the specimen list it introduces. */
  .sg-lede + .sg-narrow {
    margin-block-start: var(--space-24);
  }

  .sg-h2 + .sg-narrow {
    margin-block-end: var(--space-32);
  }

  /* Each card draws its own top rule, so the run needs closing at the bottom the
     same way the blog listing closes it. */
  .sg-cards {
    border-block-end: var(--hairline) solid var(--border);
  }

  .sg-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    gap: var(--space-32);
  }

  @media (min-width: 48em) {
    .sg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Scoped to the specimen chrome so it never competes with prose.css's
     inline-code rule inside the <Prose> samples below. */
  .sg-meta code,
  .sg-swatch code {
    font-family: var(--font-mono);
    font-size: var(--size-14);
  }
</style>
