---
// DESIGN TEMPLATE — destination: src/layouts/BaseLayout.astro  (checklist D9)
//
// The page shell. Phase 2 owns the document skeleton, the stylesheet graph, the font
// preload and the landmark structure. It does NOT own SEO: canonical URL, Open Graph,
// Twitter card and JSON-LD are the "SEO head block" component in Phase 4, which slots
// into the marked gap below. The `title` and `description` props exist now so that
// slotting it in later is additive.

import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* crossorigin is required even for a same-origin font preload. */}
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* TODO(Phase 4): <SeoHead /> goes here — canonical, OG, Twitter, JSON-LD. */}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
